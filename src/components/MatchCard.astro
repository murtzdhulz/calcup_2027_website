---
import Crest from './Crest.astro';
import type { Match, Team } from '../lib/teams';
import { url } from '../lib/url';

interface Props {
  match: Match;
  teams: Team[];
}
const { match, teams } = Astro.props;
const m = match.data;
const side = (key: string) => teams.find((t) => t.id === key);
const sides = [m.teamA, m.teamB].map((key) => ({ key, team: side(key) }));
const knockout = m.stage === 'Semi-final' || m.stage === 'Final';
---

<article
  class:list={['card flex flex-col gap-4 p-5', knockout && 'border-gold/40 bg-gradient-to-br from-gold/10 to-panel']}
  data-teams={`${m.teamA} ${m.teamB}`}
>
  <div class="flex items-center justify-between gap-3 text-sm">
    <span class:list={['chip', knockout && '!border-gold/50 !text-gold']}>{m.stage}</span>
    <span class="font-display tracking-wider text-muted uppercase">Match {m.number}</span>
  </div>
  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
    {
      sides.map(({ key, team }, i) => (
        <Fragment>
          {i === 1 && <span class="font-display text-lg font-bold text-gold/80">VS</span>}
          {team ? (
            <a href={url(`teams/${team.id}/`)} class:list={['group flex items-center gap-3', i === 1 && 'flex-row-reverse text-right']}>
              <Crest team={team} class="size-12 shrink-0" />
              <span class="font-display text-xl font-bold uppercase group-hover:text-gold">{team.data.name}</span>
            </a>
          ) : (
            <div class:list={['flex items-center gap-3', i === 1 && 'flex-row-reverse text-right']}>
              <span class="grid size-12 shrink-0 place-items-center rounded-full border border-dashed border-gold/40 font-display text-sm font-bold text-gold">
                {key.replace('Winner ', '')}
              </span>
              <span class="font-display text-lg font-semibold text-muted uppercase">{key.startsWith('Winner') ? key : `Group ${key[0]} #${key[1]}`}</span>
            </div>
          )}
        </Fragment>
      ))
    }
  </div>
  <div class="flex items-center justify-between border-t border-line pt-3 text-sm text-muted">
    <span class="font-semibold text-cream">{m.time}</span>
    <span>{m.ground}</span>
  </div>
</article>
