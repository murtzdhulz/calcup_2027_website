---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Crest from '../../components/Crest.astro';
import MatchCard from '../../components/MatchCard.astro';
import { getMatches, getTeams, roleOrder, rolePlural, type Team } from '../../lib/teams';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const teams = await getTeams();
  return teams.map((team, i) => ({
    params: { slug: team.id },
    props: { team, prev: teams[(i - 1 + teams.length) % teams.length], next: teams[(i + 1) % teams.length] },
  }));
}

interface Props {
  team: Team;
  prev: Team;
  next: Team;
}
const { team, prev, next } = Astro.props;
const { name, group, colours, kit, players, placeholder } = team.data;
const teams = await getTeams();
const fixtures = (await getMatches()).filter((m) => m.data.teamA === team.id || m.data.teamB === team.id);
const squad = roleOrder
  .map((role) => ({ role, label: rolePlural[role], players: players.filter((p) => p.role === role) }))
  .filter((r) => r.players.length);
const captain = players.find((p) => p.captain);
// "Asha Rao" -> "AR"; numbered placeholders keep their number ("Player 12" -> "P12").
const initials = (n: string) =>
  n
    .split(' ')
    .map((w) => (/^\d+$/.test(w) ? w : w[0]))
    .join('')
    .slice(0, 3)
    .toUpperCase();
---

<Base title={name} description={`${name} at CalCup 2027: squad, captain and fixtures.`}>
  <section class="relative overflow-hidden border-b border-line" style={`--p:${colours.primary};--s:${colours.secondary}`}>
    <div class="absolute inset-0 bg-[linear-gradient(115deg,var(--p)_0%,color-mix(in_oklab,var(--p)_40%,var(--color-ink))_45%,var(--color-ink)_100%)] opacity-90"></div>
    <div class="absolute inset-y-0 right-0 w-2/5 bg-[repeating-linear-gradient(135deg,transparent_0_22px,rgb(255_255_255/0.035)_22px_44px)]"></div>
    <div class="wrap relative grid items-center gap-8 py-12 sm:py-16 md:grid-cols-[auto_1fr_auto]">
      <Crest team={team} class="size-40 drop-shadow-[0_12px_30px_rgba(0,0,0,0.5)] sm:size-52" />
      <div>
        <a href={url('teams/')} class="font-display text-sm font-semibold tracking-[0.25em] text-cream/70 uppercase hover:text-cream">← All teams</a>
        <h1 class="display mt-3 text-6xl sm:text-8xl">{name}</h1>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="chip !border-cream/30 !text-cream">Group {group}</span>
          {captain && <span class="chip !border-cream/30 !text-cream">Captain · {captain.name}</span>}
          <span class="chip !border-cream/30 !text-cream">{players.length} players</span>
        </div>
        {placeholder && <p class="mt-5 text-cream/70">Placeholder team. Name, crest and squad will be updated once this team registers.</p>}
      </div>
      {kit && <Image src={kit} alt={`${name} playing kit`} width={260} class="hidden w-52 rounded-2xl md:block lg:w-64" />}
    </div>
  </section>

  <section class="wrap pt-14">
    <p class="eyebrow">Squad</p>
    <h2 class="display mt-2 text-4xl">The players</h2>
    {
      squad.map((r) => (
        <div class="mt-8">
          <h3 class="font-display text-lg font-semibold tracking-[0.2em] text-muted uppercase">{r.label}</h3>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {r.players.map((p) => (
              <li class="card flex items-center gap-4 p-4">
                <span
                  class="grid size-14 shrink-0 place-items-center rounded-full font-display text-xl font-bold"
                  style={`background:${colours.primary};color:${colours.secondary};box-shadow:inset 0 0 0 3px ${colours.secondary}`}
                >
                  {initials(p.name)}
                </span>
                <span class="min-w-0">
                  <span class="block truncate font-display text-xl font-semibold uppercase">{p.name}</span>
                  <span class="mt-1 flex flex-wrap gap-1">
                    {p.captain && <span class="rounded bg-gold px-1.5 font-display text-xs font-bold text-espresso">C</span>}
                    {p.viceCaptain && <span class="rounded border border-gold px-1.5 font-display text-xs font-bold text-gold">VC</span>}
                    <span class="text-sm text-muted">{p.role}</span>
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="wrap pt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Fixtures</p>
        <h2 class="display mt-2 text-4xl">{name} matches</h2>
      </div>
      <a href={url(`schedule/?team=${team.id}`)} class="font-display font-semibold tracking-wider text-gold uppercase hover:underline">In the schedule →</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {fixtures.map((match) => <MatchCard match={match} teams={teams} />)}
    </div>
    <p class="mt-4 text-sm text-muted">Knockout fixtures depend on group results.</p>
  </section>

  <nav class="wrap mt-16 grid grid-cols-2 gap-4" aria-label="Other teams">
    <a href={url(`teams/${prev.id}/`)} class="card flex items-center gap-4 p-4 hover:border-gold/60">
      <Crest team={prev} class="size-12" />
      <span><span class="block text-sm text-muted">← Previous</span><span class="display text-2xl">{prev.data.name}</span></span>
    </a>
    <a href={url(`teams/${next.id}/`)} class="card flex flex-row-reverse items-center gap-4 p-4 text-right hover:border-gold/60">
      <Crest team={next} class="size-12" />
      <span><span class="block text-sm text-muted">Next →</span><span class="display text-2xl">{next.data.name}</span></span>
    </a>
  </nav>
</Base>
