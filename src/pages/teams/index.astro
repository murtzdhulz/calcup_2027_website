---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Crest from '../../components/Crest.astro';
import { getTeams } from '../../lib/teams';
import { url } from '../../lib/url';

const teams = await getTeams();
const groups = (['A', 'B'] as const).map((g) => ({ name: g, teams: teams.filter((t) => t.data.group === g) }));
---

<Base title="Teams" description="The ten teams playing CalCup 2027.">
  <PageHeader
    eyebrow={`${teams.length} teams · 2 groups`}
    title="Teams"
    intro="Team names, crests and squads are placeholders. They’ll be filled in as teams register."
  />

  {
    groups.map((g) => (
      <section class="wrap pt-14">
        <h2 class="display border-b border-line pb-4 text-4xl">
          Group <span class="text-gold">{g.name}</span>
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.teams.map((team) => (
            <a
              href={url(`teams/${team.id}/`)}
              class="group relative flex items-center gap-5 overflow-hidden rounded-2xl border border-line p-5 transition hover:-translate-y-1 hover:border-gold/60"
              style={`background: linear-gradient(120deg, ${team.data.colours.primary}55 0%, var(--color-panel) 60%)`}
            >
              <Crest team={team} class="size-24 shrink-0 transition group-hover:scale-105" />
              <div>
                <p class="display text-3xl">{team.data.name}</p>
                <p class="mt-1 text-sm text-muted">{team.data.colourNames}</p>
                <p class="mt-3 font-display text-sm font-semibold tracking-widest text-gold uppercase">View squad →</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>
