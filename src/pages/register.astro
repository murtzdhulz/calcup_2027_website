---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';

const { registration: r } = site;
const options = [
  {
    title: 'Team registration',
    line: r.team.line,
    fee: r.team.fee,
    per: r.team.per,
    extra: { k: 'Location', v: site.location },
  },
  {
    title: 'Player registration',
    line: r.player.line,
    fee: r.player.fee,
    per: r.player.per,
    extra: { k: 'Spots', v: r.player.spots },
  },
];
---

<Base title="Register" description="Register a team or sign up as a player for CalCup 2027.">
  <PageHeader eyebrow="Registration open" title="Register" intro={`Deadline ${r.deadline}. Pay via Zelle to ${r.zelle}.`} />

  <section class="wrap grid gap-6 pt-14 md:grid-cols-2">
    {
      options.map((o) => (
        <div class="glow card overflow-hidden p-8">
          <h2 class="display text-4xl text-gold">{o.title}</h2>
          <p class="mt-2 text-cream/80">{o.line}</p>
          <dl class="mt-8 grid grid-cols-2 gap-6 border-y border-gold/30 py-6">
            <div>
              <dt class="eyebrow !text-xs">Registration fee</dt>
              <dd class="display mt-1 text-3xl">
                {o.fee} <span class="text-xl text-cream/70">{o.per}</span>
              </dd>
            </div>
            <div>
              <dt class="eyebrow !text-xs">Deadline</dt>
              <dd class="display mt-1 text-3xl">{r.deadline.replace(/(\w{3})\w*/, '$1')}</dd>
            </div>
            <div>
              <dt class="eyebrow !text-xs">Tournament weekend</dt>
              <dd class="display mt-1 text-3xl">{site.datesShort}</dd>
            </div>
            <div>
              <dt class="eyebrow !text-xs">{o.extra.k}</dt>
              <dd class="display mt-1 text-3xl">{o.extra.v}</dd>
            </div>
          </dl>
          <p class="mt-8 font-display text-lg font-bold tracking-wider uppercase">Pay via Zelle</p>
          <p class="mt-1 text-lg break-all text-gold">{r.zelle}</p>
        </div>
      ))
    }
  </section>
</Base>
